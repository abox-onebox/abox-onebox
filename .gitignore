# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
unpackage/
# 小程序「用户端 H5 版」的产物（本地内部测试用，见 scripts/local-test.mjs）。
# ⚠️ 刻意**不放在 `dist/` 里**：`dist/` 归 `gate.mjs build:mp` 所有（构建前整个改名挪走），
#    放进去的话**每次跑门禁都会把 H5 产物清掉**，手机测试环境随即失效。
dist-h5/
*.tsbuildinfo

# unplugin 自动生成的类型声明（构建期产物；当前未被 tsconfig include 消费）
apps/*/auto-imports.d.ts
apps/*/components.d.ts

# 环境变量（严禁入库）
.env
.env.local
.env.*.local
# ⚠️ 生产环境文件（含真实 DB 口令 / 微信支付密钥 / 灵活用工凭据）——
#    与 .env 同等对待。名字里带 prod 的这一条是 M5-0 补的：
#    原先只忽略了 .env 与 .env.*.local，`.env.prod` 会被 git 收进来。
.env.prod
.env.production
!.env.example

# ⭐ 微信支付凭据目录（商户私钥 apiclient_key.pem / 平台证书 wechatpay_*.pem）
#    绝对不能进仓库：security-scan 会扫 git 历史里的私钥。
#    部署时手工放到 <仓库根>/deploy/certs/，权限 600、属主 root。
deploy/certs/
*.pem

# H5（8081）临时访问控制（Cookie 闸门）的凭据目录（2026-10-27 加 · 备案+HTTPS 就绪后撤）
#   里面是 `Cookie 值` 的明文，拿到它 = 拿到访问权，不能进仓库。
#   生成 / 换凭据 / 撤除的命令见 apps/miniprogram/nginx.conf 末尾「闸门运维」一段。
deploy/h5/gate.d/


# 本地数据卷
data/

# 部署状态与备份（M5-0）
#   .deploy-state 记录当前/上一版 tag，回滚脚本据此找目标；它随机器而变，不入库
#   backups/ 是 mysqldump 产物，可能含全量业务数据，绝不入库
.deploy-state
backups/
# 运行期访问日志（nginx 溯源留证，含 UA / URI 等真实请求信息，保留 7 天由 cron 清理）
logs/

# 构建暂存（沙箱 bulk-delete 守卫的对策目录，见《协作规范》）
_stale-build/

# 字体子集的**源字体**（霞鹜文楷 24.4 MB，第三方发布物，不是本项目源码）
#   scripts/make-font-subset.py 需要它才能重跑子集；缺了就按该脚本注释里的 URL 重新下载。
#   ⚠️ 别把它搬进仓库：24 MB 二进制，且它随时可从上游重新获取。
scripts/.font-cache/

# Python 字节码缓存（`py_compile` / 直接跑 .py 都会产生；2026-10-07 补登 —— 此前一度被 git 看见）
__pycache__/
*.pyc

# 运行时产物
public/qrcodes/
coverage/
*.log
npm-debug.log*
pnpm-debug.log*

# 临时/验证产物（本地排障用，严禁入库）
# ⚠️ `_tmp/` 与 `_tmp_*` 是两种形态，都要挡：
#    `_tmp_*` 是散落的单文件产物；`_tmp/` 是门禁与取证脚本的工作目录
#    （如 `_tmp/gate-truth.json` 会让 `format` 报红，且它没有任何脚本在读）
_tmp_*
_tmp/
_verify*.log
_*_report.log
_commitmsg.txt

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
