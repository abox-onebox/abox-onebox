# ============================================================================
# ABox 一盒 · API 服务端环境变量（本地零依赖模式 · 开箱即用）
# ----------------------------------------------------------------------------
# 用法：cp .env.example .env     （.env 已在 .gitignore，切勿提交真实值）
#
# 本文件的默认值 = 「本地零依赖模式」：sqlite + memory + local + mock
#   → 无需 Docker / MySQL / Redis / 微信账号，即可跑通
#     「登录 → 下单 → 支付 → 回调」全链路。
#
# 切到云服务器时**只改下面 4 个驱动开关**，业务代码零改动：
#   DB_DRIVER=mysql  QUEUE_DRIVER=redis  STORAGE_DRIVER=cos  PROVIDER_MODE=real
#   （云端全量变量参考见仓库根 ../../.env.example）
#
# ⚠️ 变量名以代码为准（src/config/*.ts 的 process.env.*）。改名 = 静默失效。
# ============================================================================

# ===== 应用 =====
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
API_PREFIX=/api/v1
JWT_SECRET=abox_dev_secret_change_before_go_live
JWT_EXPIRES_IN=7d
TASKS_ENABLED=true

# ===== 驱动开关（本地 ↔ 云端零改动切换）=====
DB_DRIVER=sqlite              # sqlite | mysql
QUEUE_DRIVER=memory           # memory | redis
STORAGE_DRIVER=local          # local | minio | cos
PROVIDER_MODE=mock            # mock | real
# ⚠️ 生产 + mock 的**逃生开关**：不开（或留空）⇒ 生产带 mock **直接起不来**（main.ts 启动硬闸）
#    只认 1 / true（大小写不敏感）；0 / false / yes / 空串一律视为未开 —— 随便塞个值绕不过去
#    开了也只表示「我知道我在裸奔」：任意 code 免密登录任意身份 + 免鉴权改支付状态
ALLOW_MOCK_IN_PROD=

# ===== 数据库 =====
# DB_DRIVER=sqlite：路径按「仓库根」解析，表结构由实体自动同步
SQLITE_PATH=./data/abox-dev.sqlite
# DB_DRIVER=mysql：用以下参数（结构由 migration 管理）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_DATABASE=abox_onebox
DB_SYNCHRONIZE=false

# ===== Redis（QUEUE_DRIVER=redis 时生效）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 微信小程序（PROVIDER_MODE=real 时必填）=====
WX_MINI_APPID=
WX_MINI_SECRET=
WX_TPL_MEAL_PUBLISHED=
WX_TPL_DELIVERY_ARRIVED=
WX_TPL_COMMISSION_SETTLED=

# ===== 微信支付（PROVIDER_MODE=real 时必填）=====
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=/etc/abox/certs/apiclient_key.pem
# ⛔ 必须是 **HTTPS 公网地址**，且路径就是本服务的 `/api/v1/pay/notify`
WXPAY_NOTIFY_URL=https://api.abox.example.com/api/v1/pay/notify
# 微信支付**平台证书**（回调验签的公钥）。留空则首次回调时自动调 /v3/certificates 拉取
WXPAY_PLATFORM_CERT_PATH=/etc/abox/certs/wechatpay_platform_cert.pem
# 退款结果通知地址（可选；不配则退款结果只能靠 find_refunds 轮询）
WXPAY_REFUND_NOTIFY_URL=
# 本地没有平台证书时是否自动拉取（0/false = 关；留空 = 开）
WXPAY_AUTO_FETCH_CERT=

# ===== 灵活用工平台（C11：团长佣金代发 + 个税代扣）=====
FLEX_PLATFORM_NAME=
FLEX_PLATFORM_APP_ID=
FLEX_PLATFORM_APP_SECRET=
FLEX_PLATFORM_API_BASE=
FLEX_PLATFORM_SERVICE_FEE_RATE=

# ===== 对象存储 · COS（STORAGE_DRIVER=cos）=====
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing

# ===== 对象存储 · MinIO（STORAGE_DRIVER=minio）=====
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=abox
MINIO_SECRET_KEY=abox123456
MINIO_BUCKET=abox-uploads

# ===== 对象存储 · 本地（STORAGE_DRIVER=local，默认）=====
LOCAL_UPLOAD_DIR=./data/uploads
LOCAL_UPLOAD_PUBLIC_BASE=http://localhost:3000/static

# ===== Mock 参数（PROVIDER_MODE=mock 时生效）=====
# code=dev:<标识> 会稳定映射为「<前缀><标识>」，故 code=dev:1001 → mock_openid_1001（李明 · 首席团长）
MOCK_WX_OPENID_PREFIX=mock_openid_
# 下单后自动触发支付成功回调，无需真机支付
MOCK_PAY_AUTO_SUCCESS=true
MOCK_PAY_CALLBACK_DELAY_MS=800
