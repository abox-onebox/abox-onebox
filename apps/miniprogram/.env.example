# ============================================================================
# ABox 一盒 · 小程序环境变量样例
# ----------------------------------------------------------------------------
# 用法：cp .env.example .env（.env 已在 .gitignore）
# Vite 仅在**构建期**注入 VITE_* 前缀的变量，运行时无法读取。
# 变量名以 apps/miniprogram/src/constants/env.ts 为准。
# ============================================================================

# 后端 API 基址（本地开发指向本机 3000；生产指向备案域名）
#
# ⭐⭐ 未备案前的线上地址必须用 **8081**，不是 8080：
#   · 8081 = h5 容器（**小程序走它**）
#   · 8080 = admin 后台，且《域名DNS方案包》§59 规划「8080 仅对运营 IP
#     开放」—— 一旦收口，打 8080 的小程序全部失联。
#   2026-10-28 实测：本机 .env 曾误配 8080，产物里也打成了 8080。
#   ⚠️ .env 不入库，换机器构建时这一行必须手填，别照抄 localhost。
VITE_API_BASE_URL=http://localhost:3000/api/v1

# 微信小程序 AppID（与后端 WX_MINI_APPID 保持一致）
VITE_WX_MINI_APPID=
