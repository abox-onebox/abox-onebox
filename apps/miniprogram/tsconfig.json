{
  "extends": "../../packages/tsconfig/vue.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@abox/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@abox/shared-utils": ["../../packages/shared-utils/src/index.ts"]
