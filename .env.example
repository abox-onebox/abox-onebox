# ============================================================
# ABox 一盒 · 根环境变量样例
# 使用：cp .env.example .env   （.env 严禁入库）
# 业务参数的权威来源是 docs/ 下的文档 + 运行期 ab_config 表
#
# ⚠️⚠️ **照抄本文件上线 = 裸奔**。以下占位值必须逐个改掉（2026-09-25 补）：
#   1. JWT_SECRET=change_me_before_go_live   → 换成真随机串（否则任何人可自签超管 token）
#   2. MYSQL_ROOT_PASSWORD / DB_PASSWORD     → 换成强口令（后者生产**无内置兜底**，漏配即连不上）
#   3. PROVIDER_MODE 生产必须**显式写 real** → 漏配的后果是「任意 code 免密登录
#      任意身份 + 支付自动置为已支付」，且服务照常起、无任何报错
#   （第 3 条另见 main.ts 的 REQUIRED_IN_PROD：生产漏配即启动中止，这是第二道保险）
#
# ⚠️ 本机没装 Docker？把下面【驱动开关】切成零依赖模式即可本地开发：
#      DB_DRIVER=sqlite   QUEUE_DRIVER=memory   STORAGE_DRIVER=local
#    详见 docs/ABox一盒本地开发手册v1.0.md
# ============================================================

# ---------- 应用 ----------
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
API_PREFIX=/api/v1

# ============================================================
# 【驱动开关】—— 决定本地跑什么、云上跑什么
# ============================================================
# 数据库：mysql（生产/云） | sqlite（本地零依赖，开发期自动建表）
DB_DRIVER=mysql
# 队列：redis（生产/云 · BullMQ） | memory（本地零依赖，进程内队列）
QUEUE_DRIVER=redis
# 对象存储：cos（腾讯云） | minio（本地容器） | local（本地磁盘，零依赖）
STORAGE_DRIVER=local
# 外部依赖：mock（全部走本地假实现，无需任何真实账号） | real（真实微信/灵活用工平台）
PROVIDER_MODE=mock
# 定时任务与队列消费者开关（开发期可关，避免无意义的跑批）
TASKS_ENABLED=true

# ---------- MySQL（DB_DRIVER=mysql 时生效）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_DATABASE=abox_onebox
DB_SYNCHRONIZE=false

# ---------- 部署（docker-compose.prod.yml / deploy.sh / rollback.sh 用）----------
# ⚠️ 这一组原本缺失，而 `cp .env.example .env.prod` 正是《部署运维手册》推荐的起手式
#    ⇒ 照做会得到一份**让 compose 拒绝启动**的 .env.prod
#    （MYSQL_ROOT_PASSWORD 在 compose 里是 `${MYSQL_ROOT_PASSWORD:?...}` 硬失败项）。
#    2026-09-25 补齐。（DOCKER_USERNAME / DOMAIN / CERTBOT_EMAIL 全仓零引用，不补。）
MYSQL_ROOT_PASSWORD=change_me_before_go_live
# MySQL 容器建库用；api 侧连库用上面的 DB_DATABASE（两者通常同名）
MYSQL_DATABASE=abox_onebox
# 镜像仓库前缀与标签：deploy.sh / rollback.sh 靠 TAG 区分「当前版本」与「回滚到哪一版」
REGISTRY=abox
TAG=latest
# admin-web（nginx）对宿主暴露的端口；容器内仍是 80
ADMIN_PORT=8080

# ---------- SQLite（DB_DRIVER=sqlite 时生效 · 本地零依赖）----------
SQLITE_PATH=./data/abox-dev.sqlite

# ---------- Redis（QUEUE_DRIVER=redis 时生效）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
JWT_SECRET=change_me_before_go_live
JWT_EXPIRES_IN=7d

# ============================================================
# 外部账号（PROVIDER_MODE=real 时必填；mock 时可留空）
# ============================================================
# ---------- 微信小程序 ----------
WX_MINI_APPID=
WX_MINI_SECRET=

# ---------- 微信支付 V3 ----------
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_NOTIFY_URL=https://your-domain.com/api/v1/payments/wxpay/notify

# ---------- 灵活用工平台（团长佣金代发 + 代扣个税 · C11）----------
# 供应商 / 集散中心走人工对公转账日结，不接 API（C11）
FLEX_PLATFORM_NAME=
FLEX_PLATFORM_APP_ID=
FLEX_PLATFORM_APP_SECRET=
FLEX_PLATFORM_API_BASE=
FLEX_PLATFORM_SERVICE_FEE_RATE=

# ---------- 腾讯云 COS（STORAGE_DRIVER=cos 时生效）----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing

# ---------- MinIO（STORAGE_DRIVER=minio 时生效 · 本地替代 COS）----------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=abox
MINIO_SECRET_KEY=abox123456
MINIO_BUCKET=abox-uploads

# ---------- 本地磁盘存储（STORAGE_DRIVER=local 时生效）----------
LOCAL_UPLOAD_DIR=./data/uploads
LOCAL_UPLOAD_PUBLIC_BASE=http://localhost:3000/static

# ============================================================
# Mock 参数（PROVIDER_MODE=mock 时生效）
# ============================================================
# 同一 code 稳定映射出同一 openid，便于本地反复登录同一账号
MOCK_WX_OPENID_PREFIX=mock_openid_
# 下单后是否自动触发「支付成功」回调（免去手动调调试端点）
MOCK_PAY_AUTO_SUCCESS=true
# 模拟回调延迟（毫秒）
MOCK_PAY_CALLBACK_DELAY_MS=800

# ---------- 业务参数（C1 / C2 / C9 锁定值）----------
BIZ_UNIT_PRICE=25.80
BIZ_COMMISSION_TRAINEE=0.08
BIZ_COMMISSION_REGULAR=0.09
BIZ_COMMISSION_GOLD=0.10
BIZ_COMMISSION_CHIEF=0.12
BIZ_SUPPLIER_TOTAL=14.00
BIZ_DISTRIBUTION_CENTER=5.00
BIZ_CUTOFF_HOUR=24
